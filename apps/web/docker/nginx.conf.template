# Generated at container start by 40-nexus-config.sh from API_URL. Serves the built
# SPA and forwards /api to the NestJS API, which the Next.js server used to do.
upstream nexus_api {
    zone nexus_api 64k;
    # Re-resolve the API's hostname so a restarted API container is found again.
    resolver __RESOLVER__ valid=30s ipv6=off;
    server __API_HOSTPORT__ resolve;
}

server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 10m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        # No URI on proxy_pass: the request path (with its /api prefix) goes through unchanged.
        proxy_pass __API_SCHEME__://nexus_api;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host __API_HOST__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    # Hashed build output never changes.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /config.js {
        add_header Cache-Control "no-cache";
    }

    # Every other path is a client-side route.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
