# Database (shared PostgreSQL service)
# Use a dedicated DB for Claude Nexus (recommended: claude_nexus)
DATABASE_URL=postgresql://nexus_app:change_me@localhost:5432/claude_nexus

# Redis (BullMQ job queues for wallet/holder indexing, discovery, history scans)
REDIS_URL=redis://localhost:6379

# Blockchain APIs
ALCHEMY_API_KEY=
HELIUS_API_KEY=
# Optional: exact Relay bridge pairing on the Money dashboard (dashboard.relay.link)
RELAY_API_KEY=

# Twitter/X API
TWITTER_BEARER_TOKEN=

# Marketplace APIs
OPENSEA_API_KEY=
RESERVOIR_API_KEY=
# Optional: the holder analysis' wake-up outlook (holders' transactions, Etherscan v2)
ETHERSCAN_API_KEY=
# Holder analysis sync budget per 10-minute run (defaults shown)
# HOLDER_ANALYSIS_RUN_CALLS=300
# HOLDER_ANALYSIS_CALL_GAP_MS=500
# HOLDER_ANALYSIS_TX_BATCH=10
# HOLDER_ANALYSIS_OPENSEA_CALLS=40   (0 turns OpenSea names off)
# HOLDER_ANALYSIS_ETHERSCAN_CALLS=100 (0 turns the Etherscan outlook off)
# Largest project (in transfers) the analysis will load into the API's memory
# HOLDER_ANALYSIS_MAX_TRANSFERS=500000

# Auth
JWT_SECRET=
# Google sign-in: OAuth client id (type "Web application") from Google Cloud console.
# Add the web origin (e.g. https://nexus.example.com) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Emailed sign-in codes go out through Resend (resend.com). Without a key the API
# logs codes instead (development) or turns email sign-in off (production).
RESEND_API_KEY=
EMAIL_FROM="Nexus <no-reply@your-domain.com>"
# Passkeys default to WEB_URL's host and origin; set these if the web app is served elsewhere.
# WEBAUTHN_RP_ID=nexus.example.com
# WEBAUTHN_ORIGINS=https://nexus.example.com

# WalletConnect (get from https://cloud.reown.com)
WALLETCONNECT_PROJECT_ID=

# App
API_PORT=4000
WEB_PORT=3000
NODE_ENV=development
